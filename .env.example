# Runtime Postgres connection string. Point this at the migrated atlas-database
# instance for local fallback; when AWS_SECRET_ID_DB_CREDENTIALS is set, the
# DBClient reads host/user/password/dbname from AWS Secrets Manager instead.
DATABASE_URL=postgres://postgres:dev@localhost:5432/atlas
AWS_SECRET_ID_DB_CREDENTIALS=
AWS_REGION_OVERRIDE=
AWS_ACCESS_KEY_ID_OVERRIDE=
AWS_SECRET_ACCESS_KEY_OVERRIDE=
# Per-task pg pool size (default 10). Total Aurora connections = tasks x pool
# size, so raise freely in dev but keep production deliberate.
DB_POOL_MAX=10
# Idle pooled connections close after this long; reconnecting to Aurora costs
# TCP+TLS+auth, so dev benefits from a high value (e.g. 300000).
DB_POOL_IDLE_TIMEOUT_MS=30000

# Server (defaults exist; override as needed)
PORT=8000
LOG_LEVEL=info

# Local development only — Fargate injects AWS_REGION at runtime
AWS_REGION=us-east-1

# S3 bucket holding map assets (PMTiles, rasters, manifests)
S3_ASSETS_BUCKET=

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Used with per-user salt for encrypted database fields
# Generate with: openssl rand -base64 32
# In production, fetch from aws secrets manager
ENCRYPTION_KEY=

# Publicly reachable origin of this API (ALB/CloudFront hostname in production)
BETTER_AUTH_URL=http://localhost:8000

# Origin of the web frontend (AWS Amplify in production). CORS allowlist and
# better-auth trustedOrigins — must be exact, no trailing slash
FRONTEND_ORIGIN=http://localhost:5173

# Hologram API credentials for SIM management and cost reports
HOLOGRAM_ORG_ID=
HOLOGRAM_API_KEY=

# Emnify API credentials for SIM management and cellular costs
EMNIFY_APPLICATION_TOKEN=
EMNIFY_ORG_ID=27343
EMNIFY_SERVICE_PROFILE_ID=1435279
EMNIFY_TARIFF_PROFILE_ID=1653400

# MQTX signed API Gateway host for device control/configuration
MQTX_HOSTNAME=mqtx.torresassociates.com

# App Client ID, Secret, and Tenant ID (optional) from Azure Portal for Sign-In with Microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

RAINBOW_API_TOKEN=